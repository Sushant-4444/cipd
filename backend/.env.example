# Copy this file to .env and fill in your own values.

# Secret used to sign JWT tokens. Run `openssl rand -hex 32` to generate.
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# SQLite database file location (path relative to backend/ directory).
DATABASE_URI=file:./cms.db

# URL the admin UI will be served from. Used in cookies and admin links.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# Comma-separated list of frontend origins allowed to call the API.
PAYLOAD_PUBLIC_FRONTEND_URLS=http://localhost:3000
